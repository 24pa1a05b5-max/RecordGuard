# RecordGuard AI Backend Configuration
PROJECT_NAME="RecordGuard AI"
VERSION="1.0.0"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
DATABASE_URL="sqlite:///./recordguard.db"
UPLOAD_DIR="./uploads"
MODEL_PATH="./models/contradiction_classifier.joblib"
METRICS_PATH="./models/model_metrics.json"
MAX_UPLOAD_SIZE_MB=25
DEMO_MODE=true
CORS_ORIGINS=["*"]

# Firebase Admin SDK Configuration
# SECURITY: Never commit or copy your service account JSON into the repository!
# Set GOOGLE_APPLICATION_CREDENTIALS to the external file path of your downloaded service account key.
GOOGLE_APPLICATION_CREDENTIALS="C:/path/to/external/prototype-b19c8-firebase-adminsdk-key.json"
FIREBASE_PROJECT_ID="prototype-b19c8"

# Set to true to strictly require valid Firebase ID tokens on protected endpoints
FIREBASE_AUTH_REQUIRED=false
